# 复制为 .env 后修改。docker compose 会自动读取同目录 .env。
# MySQL root 密码（必填）
DB_PASSWORD=change-me
# JWT 签名密钥（必填，生产环境请用随机长字符串，如：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-random-secret
# 数据库名
DB_NAME=muster
# 报名表单对外基础地址（扫码后浏览器访问的地址；用 Cloudflare 域名时填 https://你的域名）
FORM_BASE_URL=http://localhost/
# 对外 HTTP 端口
HTTP_PORT=80
# 前端容器监听地址：配合 Cloudflare Tunnel / 本机反代时填 127.0.0.1（不对公网开放）
BIND_ADDR=0.0.0.0
